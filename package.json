{
  "name": "klods",
  "version": "0.1.0",
  "private": true,
  "description": "Notices de montage LEGO® en 3D, étape par étape.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"scripts/**/*.test.ts\" \"src/**/*.test.ts\"",
    "data": "npm run data:omr && npm run data:ldraw && npm run data:rebrickable && npm run data:pack && npm run check && npm run data:index",
    "data:omr": "node scripts/data/omr-fetch.ts",
    "data:ldraw": "node scripts/data/ldraw-fetch.ts",
    "data:rebrickable": "node scripts/data/rebrickable-fetch.ts",
    "data:pack": "node scripts/data/pack.ts",
    "data:index": "node scripts/data/build-index.ts",
    "check": "node scripts/data/check.ts",
    "data:fixtures": "node scripts/data/fixtures.ts",
    "e2e": "playwright test",
    "data:covers": "node scripts/data/covers.ts",
    "data:themes": "node scripts/data/themes-report.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "typescript": "5.9.3"
  },
  "type": "module"
}
